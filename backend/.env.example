# ========== Obligatoire ==========
# PostgreSQL (Supabase, Neon ou autre). En production, obligatoire.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# TLS Postgres : si l’URL contient supabase.co / pooler.supabase.com, le backend retire sslmode de l’URL et
# utilise une connexion chiffrée sans vérif du certificat (évite « self-signed certificate in chain »).
# Autre hébergeur avec le même symptôme : DATABASE_SSL_INSECURE=true
# Vérification stricte du certificat (désactive le comportement ci-dessus pour Supabase) : DATABASE_SSL_STRICT=true
# DATABASE_SSL_STRICT=true
# DATABASE_SSL_INSECURE=true

# En production : secret fort (min. 32 caractères aléatoires). Jamais le défaut dev.
JWT_SECRET="votre-secret-jwt-tres-long-et-aleatoire"

# URL du frontend (Vercel). Utilisée pour CORS et liens d’activation.
FRONTEND_URL="https://votre-app.vercel.app"

# ========== Optionnel / fonctionnalités ==========
# Indicatif pays pour les numéros : 33 (France), 225 (Côte d'Ivoire)
COUNTRY_CODE="225"

# ========== Jeko (paiement en ligne : Wave, Orange Money, MTN, Moov, Djamo) ==========
# Obtenir les clés : https://cockpit.jeko.africa → Paramètres > API & Webhooks
JEKO_API_KEY=""
JEKO_API_KEY_ID=""
JEKO_STORE_ID=""
# Secret webhook : Cockpit Jeko → Paramètres > API & Webhooks → Secret webhook
# URL à configurer : https://votre-backend.onrender.com/webhooks/jeko
JEKO_WEBHOOK_SECRET=""

# ========== Email (relances + confirmations paiement) ==========
# Si vide : emails désactivés (SMS seul).
# Compatible Gmail (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false)
# ou tout autre fournisseur SMTP (Brevo, Mailgun, etc.)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AFC Amicale <noreply@votre-domaine.com>"

# ========== Sayelesend (SMS + WhatsApp) ==========
# Clé API Sayelesend (Bearer token). Si vide : mode démo (lien d'activation affiché à l'écran).
# Obtenir une clé : https://sayelesend.com
SAYELESEND_API_KEY=""
# Sender ID optionnels (par défaut : celui défini côté compte Sayelesend)
SAYELESEND_SMS_FROM=""
SAYELESEND_WHATSAPP_FROM=""

# Supabase Storage (avatars). Si vides : avatars stockés sur le disque du serveur (éphémère sur Render).
# Créer un bucket "avatars" dans Supabase Storage et le rendre public en lecture.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Port (Render / hébergeur le définit souvent)
PORT=3000

# Environnement (production = CORS strict, validation JWT_SECRET)
NODE_ENV=development
